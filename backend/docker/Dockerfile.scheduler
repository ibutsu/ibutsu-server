# hadolint global ignore=DL3013,DL3041,DL3059
FROM registry.access.redhat.com/ubi9/python-314-minimal:9.8-1788215168

ARG UV_VERSION=0.12.10

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH"

USER 0

WORKDIR /app

RUN curl -sSfL "https://releases.astral.sh/github/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
        -o /tmp/uv.tar.gz && \
    tar -xzf /tmp/uv.tar.gz -C /tmp && \
    install -m 0755 -t /bin \
        /tmp/uv-x86_64-unknown-linux-gnu/uv /tmp/uv-x86_64-unknown-linux-gnu/uvx && \
    rm -rf /tmp/uv.tar.gz /tmp/uv-x86_64-unknown-linux-gnu

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-default-groups --no-install-project

COPY . /app
COPY licenses/ /licenses/
RUN /usr/bin/fix-permissions /app

RUN uv sync --frozen --no-dev --no-default-groups

RUN chgrp -R 0 ibutsu_server && chmod -R g+rwX ibutsu_server

USER 1001

# Use scheduler_app (full Flask integration with database)
# scheduler_app is exposed via __getattr__ in ibutsu_server/__init__.py
CMD ["celery", "--app", "ibutsu_server:scheduler_app", "beat", "--loglevel=info", "--pidfile=ibutsu_server/celerybeat.pid", "--schedule=ibutsu_server/celerybeat-schedule"]
