# hadolint global ignore=DL3002,DL3041,DL3025,DL3059
FROM registry.access.redhat.com/ubi9/python-314:1-1795320644 AS builder

# renovate: datasource=pypi depName=uv
ARG UV_VERSION=0.13.4

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/bin/python3.14 \
    PATH="/app/.venv/bin:$PATH"

USER 0

WORKDIR /app

RUN python3.14 -m pip install --no-cache-dir "uv==${UV_VERSION}"

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-default-groups --only-group flower --no-install-project

COPY . /app
RUN uv build && \
    uv pip install --python /app/.venv/bin/python --no-deps dist/*.whl && \
    chgrp -R 0 /app && \
    chmod -R g=u /app

FROM registry.access.redhat.com/ubi9/python-314-minimal:9.9-1795233991

ENV PATH="/app/.venv/bin:$PATH"

USER 0

WORKDIR /app

RUN microdnf install --nodocs -y file-libs && \
    microdnf clean all && \
    chgrp 0 /app && \
    chmod g=u /app

COPY --from=builder --chown=1001:0 /app /app
COPY licenses/ /licenses/

USER 1001

# Fail the build if the flower dependency group stops covering what flower_app imports
RUN CELERY_BROKER_URL=redis://build-check:6379 \
    python -c "import flower; from ibutsu_server.celery_utils import flower_app"

# Expose Flower default port
EXPOSE 5555

# Use flower_app - minimal broker-only app (no database required)
# flower_app is created lazily by __getattr__ in ibutsu_server/celery_utils.py
CMD ["celery", "--app=ibutsu_server.celery_utils:flower_app", "flower", "--port=5555", "--enable_events=True"]
