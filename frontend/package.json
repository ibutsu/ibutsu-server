  "scripts": {
    "start": "serve -s build -l tcp://0.0.0.0:8080",
    "build": "./bin/write-version-file.cjs && vite build",
    "test": "./bin/write-version-file.cjs && vitest run",
    "test:coverage": "./bin/write-version-file.cjs && vitest run --coverage",
    "test:coverage:ci": "./bin/write-version-file.cjs && vitest run --coverage --reporter=default --maxWorkers=2",
    "devserver": "./bin/write-version-file.cjs && vite",
    "preview": "vite preview --port 8080",
    "lint": "eslint --fix",
    "format": "prettier \"src/**/*.{js,html}\" --write",
    "format-check": "prettier \"src/**/*.{js,html}\" --check"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1"
